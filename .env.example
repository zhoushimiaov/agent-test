# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交。
# 用法: set -a; source .env; set +a; node jev-score.mjs

# TypeSafe System One（Jev 评分）密钥 —— 只放这里，切勿写进代码或提交
TYPESAFE_API_KEY=

# Node 的 undici fetch 默认不走代理，会被 TypeSafe 以 HTTP 451 拒绝；评分时需要:
#   NODE_USE_ENV_PROXY=1 http_proxy=http://127.0.0.1:7897 https_proxy=http://127.0.0.1:7897 all_proxy=http://127.0.0.1:7897
